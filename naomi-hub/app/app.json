{
  "expo": {
    "name": "Numi's Super App",
    "slug": "naomi-hub",
    "owner": "fjclausen",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "naomihub",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EE"
    },
    "ios": {
      "supportsTablet": true,
      "isTabletOnly": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.fjclausen.naomihub",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of a finished puzzle sheet so the app can check the answers.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f68ff8c9-01d7-4441-b7c5-b8d32c39ef5d"
      }
    }
  }
}
