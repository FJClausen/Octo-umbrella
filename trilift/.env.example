# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* vars into the client bundle,
# so ONLY put values here that are safe to ship in an app binary.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe on-device: it is gated by row-level security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# The values below are NOT used by the app. They are set as Supabase Edge
# Function secrets (`supabase secrets set ...`) so they never reach the device.
# Listed here only so the full set of required config lives in one place.
#
#   STRAVA_CLIENT_ID=
#   STRAVA_CLIENT_SECRET=
#   ANTHROPIC_API_KEY=
#   APP_REDIRECT_URL=trilift://strava-callback
# ---------------------------------------------------------------------------
